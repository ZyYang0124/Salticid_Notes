---
export const prerender = true;
import Base from '../../layouts/Base.astro';
import { getPublishedPost, getPublishedPosts, getPostLinks } from '../../lib/queries';
import { withBase } from '../../lib/privacy';
import { formatDate, sciNameHtml } from '../../lib/format';

export function getStaticPaths() {
  return getPublishedPosts().map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const post = getPublishedPost(slug!);
if (!post) return Astro.redirect(withBase('/posts/'));
const links = getPostLinks(post);
const ordered = getPublishedPosts();
const idx = ordered.findIndex((p) => p.slug === slug);
const newer = idx > 0 ? ordered[idx - 1] : null;   // 下一篇（更新）
const older = idx >= 0 && idx < ordered.length - 1 ? ordered[idx + 1] : null; // 上一篇（更旧）
---

<Base title={post.title} description={post.bodyHtml.replace(/<[^>]+>/g, ' ').slice(0, 90)}>
  <article class="story">
    <header class="story-hero">
      <div class="hero-kicker">札 记</div>
      <h1 class="hero-title">{post.title}</h1>
      {post.subtitle && <p class="hero-dek">{post.subtitle}</p>}
      <div class="hero-meta">
        <span>{formatDate(post.created_at.slice(0, 10), 'day')}</span>
        <span class="meta-dot"></span>
        <span>{post.author}</span>
      </div>
    </header>

    {post.cover && (
      <figure class="story-cover">
        <img src={post.cover.large} alt={post.title} fetchpriority="high" width={post.cover.width} height={post.cover.height} decoding="async" />
      </figure>
    )}

    <div class="story-body post-body" set:html={post.bodyHtml} />

    {(post.relatedObservations.length > 0 || links.species.length > 0 || links.places.length > 0) && (
      <section class="story-related">
        <h2 class="related-kicker">本篇关联</h2>

        {post.relatedObservations.length > 0 && (
          <div class="side-secondary" style="margin-bottom: 22px;">
            <div class="related-sub">文中观察</div>
            {post.relatedObservations.map((o) => (
              <div><a href={o.url} style="text-decoration: underline; text-decoration-color: var(--line); text-underline-offset: 3px;">{o.public_id}</a> · {o.display ?? '未鉴定的跳蛛'}</div>
            ))}
          </div>
        )}

        {links.species.length > 0 && (
          <div style="margin-bottom: 22px;">
            <div class="related-sub">相关物种</div>
            <div class="related-chips">
              {links.species.map((s) =>
                s.url ? (
                  <a class="related-chip" href={s.url}><span set:html={sciNameHtml(s.display, s.rank ?? 'species')} /></a>
                ) : (
                  <span class="related-chip"><span set:html={sciNameHtml(s.display, s.rank ?? 'species')} /></span>
                )
              )}
            </div>
          </div>
        )}

        {links.places.length > 0 && (
          <div class="side-secondary">
            <div class="related-sub">相关地点</div>
            {links.places.map((p) => (
              <div><a href={p.url} style="text-decoration: underline; text-decoration-color: var(--line); text-underline-offset: 3px;">{p.name}</a></div>
            ))}
          </div>
        )}
      </section>
    )}

    <nav class="post-pager" aria-label="札记导航">
      {older && (
        <a class="pager-item" href={withBase(`/posts/${older.slug}/`)}>
          <span class="dir">← 上一篇</span>
          <span class="pt">{older.title}</span>
        </a>
      )}
      {newer && (
        <a class="pager-item next" href={withBase(`/posts/${newer.slug}/`)}>
          <span class="dir">下一篇 →</span>
          <span class="pt">{newer.title}</span>
        </a>
      )}
      <a class="pager-back" href={withBase('/posts/')}>返回札记</a>
    </nav>
  </article>
</Base>

<style>
  /* 札记排版：杂志式刊头 + 740px 衬线正文 + 图片跳出文本栏（参考自然史故事页结构） */
  .story { max-width: 1080px; margin: 0 auto; padding: 8px 24px 70px; }

  /* ---- 刊头 ---- */
  .story-hero { text-align: center; max-width: 760px; margin: 44px auto 40px; }
  .hero-kicker {
    font-family: var(--sans); font-size: 13px; font-weight: 600;
    letter-spacing: 0.14em; color: var(--terra);
    margin: 0 0 24px;
  }
  .hero-title {
    font-family: var(--serif); font-size: clamp(2.4rem, 5vw, 3.4rem); /* 明显大于普通页标题（§4） */
    font-weight: 700; letter-spacing: 0.06em; text-indent: 0.06em;
    line-height: 1.32; margin: 0 0 18px;
  }
  .hero-dek {
    letter-spacing: 0.08em; color: var(--muted);
    font-size: clamp(0.95rem, 1.6vw, 1.05rem); margin: 0 0 24px;
  }
  .hero-meta {
    display: flex; justify-content: center; align-items: center; gap: 10px;
    font-size: 13px; color: var(--faint); letter-spacing: 0.06em;
  }
  .meta-dot { width: 3px; height: 3px; border-radius: 50%; background: var(--faint); }

  /* ---- 封面大图：通栏 ---- */
  .story-cover { margin: 0 auto 8px; max-width: min(100%, 1080px); }
  .story-cover img { width: 100%; height: auto; display: block; }

  /* ---- 正文：740px 衬线阅读栏 ---- */
  .story-body {
    max-width: 720px; margin: 0 auto; /* §5：正文 680–720 */
    font-family: var(--serif); font-size: 17.5px; line-height: 1.95; color: var(--ink);
  }
  .story-body :global(p) { margin: 0 0 1.55em; text-align: justify; }
  /* 小节标题 = 居中章节分隔：字距拉开 + 短线（红栏杆 motif 的克制用法） */
  .story-body :global(h2) {
    display: flex; align-items: center; justify-content: center; gap: 18px;
    font-family: var(--serif); font-size: 1.28rem; font-weight: 700;
    letter-spacing: 0.2em; text-indent: 0.2em; color: var(--ink);
    margin: 3em 0 1.6em; text-align: center; white-space: nowrap;
  }
  /* 参考自然史故事页：标题两侧细线 */
  .story-body :global(h2)::before,
  .story-body :global(h2)::after {
    content: ''; flex: 1; height: 1px; background: var(--line); min-width: 40px;
  }
  /* 左图右文小节（§参考）：桌面图左文右，窄屏堆叠 */
  .story-body :global(.duo) {
    display: grid; grid-template-columns: minmax(0, 44%) minmax(0, 1fr);
    gap: 30px; align-items: center; margin: 2.2em 0;
  }
  .story-body :global(.duo .article-media),
  .story-body :global(.duo figure) { margin: 0; max-width: none; }
  .story-body :global(.duo img) { margin: 0; max-height: 62vh; }
  .story-body :global(.duo .duo-text p) { margin: 0 0 1.3em; }
  .story-body :global(.duo .duo-text p:last-child) { margin-bottom: 0; }
  .story-body :global(h3) {
    font-size: 17px; letter-spacing: 0.06em; margin: 2em 0 0.8em; color: var(--ink);
  }
  .story-body :global(blockquote) {
    margin: 1.8em 0; padding: 6px 20px; border-left: 2px solid var(--line);
    color: var(--muted);
  }
  .story-body :global(code) { background: var(--paper-deep); padding: 1px 6px; font-size: 0.85em; }

  /* ---- 图片：跳出 740px 文本栏，居中，上限 1080px / 80vh；不裁切 ---- */
  .story-body :global(img) {
    display: block; margin: 2em auto; max-width: min(100%, 900px); /* 普通图（§6） */
    height: auto; max-height: 80vh;
  }
  .story-body :global(figure) { margin: 2.4em auto; max-width: min(100%, 900px); }
  .story-body :global(figure img) { margin: 0 auto; max-height: 80vh; }
  /* 宽幅图（横构图或标记 wide）：1200px，形成窄文字→宽图片的节奏 */
  .story-body :global(.article-media.am-panorama),
  .story-body :global(.am-panorama) { max-width: min(100%, 1200px); margin-left: calc((720px - 100%) / 2); margin-right: calc((720px - 100%) / 2); }
  .story-body :global(figcaption) {
    text-align: left; font-family: var(--sans); font-size: 13px;
    line-height: 1.7; color: var(--muted); margin-top: 10px;
  }
  /* 连续图片组合 */
  .story-body :global(.article-media),
  .story-body :global(.article-media-group),
  .story-body :global(.article-media-group figure) { margin: 2.4em auto; }
  .story-body :global(.article-media-group) { display: grid; gap: 12px; max-width: min(100%, 1080px); }
  .story-body :global(.article-media-group .article-media) { max-width: none; }
  .story-body :global(.amg-pair) { grid-template-columns: 1fr 1fr; }
  .story-body :global(.amg-triptych) { grid-template-columns: 1fr 1fr 1fr; }
  .story-body :global(.amg-grid4), .story-body :global(.amg-grid) { grid-template-columns: 1fr 1fr; }
  .story-body :global(.am-portrait) { max-width: min(74%, 560px); margin-inline: auto; }
  .story-body :global(.am-panorama) { max-width: none; }
  .story-body :global(.article-media-group img) { max-height: 76vh; }
  .story-body :global(.article-media-group figcaption),
  .story-body :global(.am figcaption) { margin-top: 8px; }
  /* 观察嵌入卡：居中、安静 */
  /* 轻量图文引用（§10）：borderless、无阴影、大量留白 */
  .story-body :global(.article-embed) {
    border: none; background: none; border-radius: 0;
    padding: 0; margin: 2.2em auto; max-width: 560px;
    font-family: var(--sans); font-size: 14px;
  }
  .story-body :global(.article-embed.is-missing) { color: var(--terra); }
  .story-body :global(.article-embed a) { display: flex; gap: 18px; align-items: center; text-decoration: none; }
  .story-body :global(.article-embed a:hover .embed-body strong) { text-decoration: underline; text-decoration-color: var(--line); text-underline-offset: 3px; }
  .story-body :global(.article-embed img) {
    width: 104px; height: 104px; object-fit: cover; border-radius: 0; margin: 0; flex: none;
  }
  .story-body :global(.embed-body) { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
  .story-body :global(.embed-id) { color: var(--faint); font-size: 12px; display: block; letter-spacing: 0.06em; }
  .story-body :global(.embed-body strong) { font-weight: 600; font-size: 15.5px; }
  .story-body :global(.embed-body span) { color: var(--muted); font-size: 13px; }
  .story-body :global(.embed-body)::after {
    content: '查看观察 →';
    font-size: 12.5px; color: var(--muted); margin-top: 4px;
  }
  .story-body :global(.article-embed a:hover .embed-body)::after { color: var(--terra); }

  /* ---- 本篇关联 ---- */
  .story-related { max-width: 740px; margin: 3.5em auto 0; }
  .related-kicker {
    font-family: var(--sans); font-size: 13px; font-weight: 600;
    letter-spacing: 0.14em; color: var(--muted); margin: 0 0 16px;
  }
  .related-sub {
    font-size: 12.5px; font-weight: 600; letter-spacing: 0.05em;
    color: var(--faint); margin-bottom: 8px;
  }
  .related-chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .related-chip {
    display: inline-block; border: 1px solid var(--line); border-radius: 999px;
    padding: 4px 12px; font-size: 13.5px; color: var(--ink); text-decoration: none; background: var(--surface);
  }
  a.related-chip:hover { border-color: var(--terra); }
  .side-secondary { font-size: 14.5px; line-height: 2.1; color: var(--ink); }
  /* ---- 页面底部：上一篇 / 下一篇 / 返回札记（§11） ---- */
  .post-pager {
    max-width: 720px; margin: var(--s-8) auto 0; padding-top: var(--s-5);
    border-top: 1px solid var(--line-soft);
    display: grid; grid-template-columns: 1fr 1fr; gap: var(--s-5);
  }
  .pager-item { display: flex; flex-direction: column; gap: 4px; text-decoration: none; min-width: 0; }
  .pager-item.next { text-align: right; }
  .pager-item .dir { font-size: 12px; letter-spacing: 0.1em; color: var(--faint); }
  .pager-item .pt {
    font-family: var(--serif); font-size: 15.5px; color: var(--ink); line-height: 1.6;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  }
  .pager-item:hover .pt { text-decoration: underline; text-decoration-color: var(--line); text-underline-offset: 3px; }
  .pager-back {
    grid-column: 1 / -1; margin-top: var(--s-2);
    font-size: 13.5px; color: var(--muted); text-decoration: none;
  }
  .pager-back:hover { color: var(--terra); }

  @media (max-width: 640px) {
    .story { padding: 4px 18px 56px; }
    .post-pager { grid-template-columns: 1fr; }
    .pager-item.next { text-align: left; }
    .story-body { font-size: 17px; }
    .story-hero { margin: 28px auto 30px; }
    .hero-title { letter-spacing: 0.06em; text-indent: 0.06em; }
    .story-body :global(.amg-triptych) { grid-template-columns: 1fr; }
    .story-body :global(.duo) { grid-template-columns: 1fr; gap: 14px; }
    .story-body :global(h2) { white-space: normal; }
    .story-body :global(.am-portrait) { max-width: 100%; }
  }
</style>
