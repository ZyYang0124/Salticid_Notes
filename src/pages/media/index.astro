---
export const prerender = true;
import Base from '../../layouts/Base.astro';
import { getAllPublicMedia } from '../../lib/queries';
import PictureImage from '../../components/PictureImage.astro';
import { withBase } from '../../lib/privacy';
import { sciNameHtml } from '../../lib/format';
import { VIEW_TYPE_ZH } from '../../lib/labels';

const archive = getAllPublicMedia();
// 按编号排序，新发布的在前；统一框架居中裁切，保持档案整齐
archive.sort((a, b) => b.media.public_id.localeCompare(a.media.public_id));
---

<Base title="照片档案" description="全部公开影像的可引用档案——每张照片都有稳定编号与出处。">
  <div class="container-wide">
    <div class="page-title">
      <h1>照片档案</h1>
      <p class="lede">
        全部公开影像（{archive.length} 张）。每张照片都有稳定编号（SN-YYYY-NNNNN）与完整出处——观察、地点、日期、摄影者与授权，可单独引用与追溯。
      </p>
    </div>

    <div class="media-tools">
      <input id="media-q" placeholder="搜索编号 / 物种 / 摄影者 / 地点 / 年份" autocomplete="off" />
      <select id="media-vt">
        <option value="">全部类型</option>
        {Object.entries(VIEW_TYPE_ZH)
          .filter(([v]) => v !== 'vulva')
          .map(([v, label]) => <option value={v}>{label}</option>)}
      </select>
    </div>

    <div class="archive-grid">
      {archive.map(({ media, observationPublicId, display }) => (
        <a
          class="archive-card"
          href={media.detail_url}
          data-q={`${media.public_id} ${display ?? ''} ${media.photographer ?? ''} ${observationPublicId ?? ''} ${media.caption ?? ''}`.toLowerCase()}
          data-vt={media.view_type}
        >
          <div class="frame">
            <PictureImage media={media} sizes="(max-width: 700px) 44vw, 240px" alt={media.caption ?? media.public_id} />
          </div>
          <div class="meta">
            <div class="pid">{media.public_id}</div>
            <div class="name">
              {display ? <span set:html={sciNameHtml(display, 'species')} /> : <span>未鉴定的跳蛛</span>}
            </div>
            <div class="sub">
              {VIEW_TYPE_ZH[media.view_type as keyof typeof VIEW_TYPE_ZH] ?? media.view_type}
              <br />
              <span class="who">© {media.photographer}</span>
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</Base>

<style>
  /* 照片档案：按编号排列（新发布在前）的整齐网格，统一框架居中裁切；
     图片由 PictureImage 子组件渲染，规则必须 :global 才能命中。 */
  .archive-grid {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
    gap: 22px; padding: 6px 0 40px;
  }
  .archive-card { display: block; }
  .archive-card .frame {
    aspect-ratio: 4 / 5; overflow: hidden;
    background: var(--paper-deep); border-radius: var(--radius-img, 2px);
  }
  .archive-card :global(img) {
    width: 100%; height: 100%; object-fit: cover; display: block;
    transition: transform 0.5s var(--ease-out, ease);
  }
  @media (hover: hover) and (pointer: fine) {
    .archive-card:hover :global(img) { transform: scale(1.015); }
  }
  .archive-card .meta { padding: 8px 2px 0; }
  .archive-card .pid { font-size: 11px; color: var(--faint); letter-spacing: 0.14em; }
  .archive-card .name { font-size: 14.5px; margin-top: 2px; }
  .archive-card .name :global(i) { font-family: var(--serif); }
  .archive-card .sub { font-size: 12px; color: var(--faint); margin-top: 3px; line-height: 1.7; }
  @media (max-width: 640px) { .archive-grid { grid-template-columns: repeat(2, 1fr); gap: 14px; } }
  /* 轻量检索（§43-45）：编号 / 物种 / 摄影者 / 年份，与类型筛选 */
  .media-tools { display: flex; gap: 12px; margin: 6px 0 22px; }
  .media-tools input {
    flex: 1; max-width: 380px; font: inherit; font-size: 14px;
    border: none; border-bottom: 1px solid var(--line); background: transparent;
    padding: 8px 2px; color: var(--ink);
  }
  .media-tools input:focus { outline: none; border-bottom-color: var(--accent); }
  .media-tools select { font: inherit; font-size: 13.5px; border: 1px solid var(--line); border-radius: 8px; background: #fff; color: var(--ink); padding: 7px 10px; }
</style>

<script>
  function initMediaFilter() {
    var q = document.getElementById('media-q');
    var vt = document.getElementById('media-vt');
    if (!q || !vt || q.dataset.init === '1') return;
    q.dataset.init = '1';
    var cards = Array.prototype.slice.call(document.querySelectorAll('.archive-card'));
    function apply() {
      var kw = q.value.trim().toLowerCase();
      var t = vt.value;
      cards.forEach(function (card) {
        var okKw = !kw || (card.getAttribute('data-q') || '').indexOf(kw) !== -1;
        var okT = !t || card.getAttribute('data-vt') === t;
        card.style.display = okKw && okT ? '' : 'none';
      });
    }
    q.addEventListener('input', apply);
    vt.addEventListener('change', apply);
  }
  document.addEventListener('astro:page-load', initMediaFilter);
  initMediaFilter();
</script>
