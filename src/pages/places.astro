---
export const prerender = true;
import Base from '../layouts/Base.astro';
import { getLocalityCards } from '../lib/queries';
import { withBase } from '../lib/privacy';

const cards = getLocalityCards();
// 全球地理：顶层按国家分组，其下按一级行政区（SOP §104）
const byCountry = new Map<string, Map<string, typeof cards>>();
for (const c of cards) {
  const byAdmin1 = byCountry.get(c.country_name) ?? new Map<string, typeof cards>();
  const list = byAdmin1.get(c.admin1) ?? [];
  list.push(c);
  byAdmin1.set(c.admin1, list);
  byCountry.set(c.country_name, byAdmin1);
}
---

<Base title="地点" description="每一次相遇都有明确的位置。按国家与地点浏览观察记录。">
  <div class="container-wide">
    <div class="page-title">
      <h1>地点</h1>
      <p class="lede">
        本站的主角是地方：一片林缘、一段河谷、一面城市里的老墙。
      </p>
    </div>

    <div class="place-groups">
      {[...byCountry.entries()].map(([country, byAdmin1]) => (
        <section class="place-group">
          <h2>{country}<span class="n">{[...byAdmin1.values()].flat().reduce((n, c) => n + c.count, 0)} 次相遇</span></h2>
          {[...byAdmin1.entries()].map(([admin1, list]) => (
          <div style="margin-bottom: 30px;">
            <div class="kicker on-paper" style="margin-bottom: 12px;">{admin1}</div>
            <div class="place-cards">
            {list.map((c) => (
              c.place_id ? (
                <a class="place-card" href={withBase(`/places/${c.place_id}/`)}>
                  <div class="frame">{c.cover && <img src={c.cover.medium} alt={c.name} loading="lazy" />}</div>
                  <div class="name">{c.name}</div>
                  <div class="meta">
                    {c.admin1}
                    {c.elevation != null && ` · 海拔约 ${c.elevation} m`}
                    {` · ${c.count} 次相遇`}
                  </div>
                  {c.habitats.length > 0 && <div class="habitats">{c.habitats.join(' / ')}</div>}
                </a>
              ) : (
                <div class="place-card">
                  <div class="frame">{c.cover && <img src={c.cover.medium} alt={c.name} loading="lazy" />}</div>
                  <div class="name">{c.name}</div>
                  <div class="meta">
                    {c.admin1}
                    {c.elevation != null && ` · 海拔约 ${c.elevation} m`}
                    {` · ${c.count} 次相遇`}
                  </div>
                  {c.habitats.length > 0 && <div class="habitats">{c.habitats.join(' / ')}</div>}
                </div>
              )
            ))}
            </div>
          </div>
          ))}
        </section>
      ))}
      <p class="place-legend">
        本站所有观察地点坐标均精确公开（可在地图中直接查看）。本页仅显示本站实际记录，不代表任何物种的完整分布；具体观察请到「观察」页按永久编号检索。
      </p>
    </div>
  </div>
</Base>
