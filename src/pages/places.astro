---
export const prerender = true;
import Base from '../layouts/Base.astro';
import { getLocalityCards } from '../lib/queries';
import { withBase } from '../lib/privacy';

const cards = getLocalityCards();
// 地图模块数据：有坐标的地点（坐标全量公开，§地点）
const mapPoints = cards
  .filter((c) => c.latitude != null && c.longitude != null)
  .map((c) => ({
    lat: c.latitude,
    lng: c.longitude,
    name: c.name,
    count: c.count,
    url: c.place_id ? withBase(`/places/${c.place_id}/`) : null,
  }));
// 全球地理：顶层按国家分组，其下按一级行政区（SOP §104）
const byCountry = new Map<string, Map<string, typeof cards>>();
for (const c of cards) {
  const byAdmin1 = byCountry.get(c.country_name) ?? new Map<string, typeof cards>();
  const list = byAdmin1.get(c.admin1) ?? [];
  list.push(c);
  byAdmin1.set(c.admin1, list);
  byCountry.set(c.country_name, byAdmin1);
}
---

<Base title="地点" description="每一次相遇都有明确的位置。按国家与地点浏览观察记录。">
  <div class="container-wide">
    <div class="page-title">
      <h1>地点</h1>
      <p class="lede">
        本站的主角是地方：一片林缘、一段河谷、一面城市里的老墙。
      </p>
    </div>

    {mapPoints.length > 0 && (
      <div class="places-map-panel">
        <div id="places-map" class="places-map" />
        <script type="application/json" id="places-map-data" set:html={JSON.stringify(mapPoints)} />
        <div class="places-map-legend">分布 · 点击标记查看 <span class="n">{mapPoints.length} 处</span><span class="src">省界轮廓 DataV.GeoJSON</span></div>
      </div>
    )}

    <div class="place-groups">
      {[...byCountry.entries()].map(([country, byAdmin1]) => (
        <section class="place-group">
          <h2>{country}<span class="n">{[...byAdmin1.values()].flat().reduce((n, c) => n + c.count, 0)} 次相遇</span></h2>
          {[...byAdmin1.entries()].map(([admin1, list]) => (
          <div style="margin-bottom: 30px;">
            <div class="kicker on-paper" style="margin-bottom: 12px;">{admin1}</div>
            <div class="place-cards">
            {list.map((c) => (
              c.place_id ? (
                <a class="place-card" href={withBase(`/places/${c.place_id}/`)}>
                  <div class="frame">{c.cover && <img src={c.cover.medium} alt={c.name} loading="lazy" />}</div>
                  <div class="name">{c.name}</div>
                  <div class="meta">
                    {c.admin1}
                    {c.elevation != null && ` · 海拔约 ${c.elevation} m`}
                    {` · ${c.count} 次相遇`}
                  </div>
                  {c.habitats.length > 0 && <div class="habitats">{c.habitats.join(' / ')}</div>}
                </a>
              ) : (
                <div class="place-card">
                  <div class="frame">{c.cover && <img src={c.cover.medium} alt={c.name} loading="lazy" />}</div>
                  <div class="name">{c.name}</div>
                  <div class="meta">
                    {c.admin1}
                    {c.elevation != null && ` · 海拔约 ${c.elevation} m`}
                    {` · ${c.count} 次相遇`}
                  </div>
                  {c.habitats.length > 0 && <div class="habitats">{c.habitats.join(' / ')}</div>}
                </div>
              )
            ))}
            </div>
          </div>
          ))}
        </section>
      ))}
      <p class="place-legend">
        本站所有观察地点坐标均精确公开（可在地图中直接查看）。本页仅显示本站实际记录，不代表任何物种的完整分布；具体观察请到「观察」页按永久编号检索。
      </p>
    </div>
  </div>

  <link rel="stylesheet" href={withBase('/vendor/leaflet.css')} />
  <script is:inline src={withBase('/vendor/leaflet.js')}></script>
  <script is:inline>
    (function () {
      function init() {
        var el = document.getElementById('places-map');
        var dataEl = document.getElementById('places-map-data');
        if (!el || !dataEl || el.dataset.inited === '1') return;
        if (typeof L === 'undefined') return;
        el.dataset.inited = '1';
        var pts = JSON.parse(dataEl.textContent || '[]');
        var map = L.map(el, {
          zoomControl: false, scrollWheelZoom: false,
          attributionControl: false, zoomSnap: 0.25,
        });
        el.classList.add('places-map-dark');
        // 分布底图：中国省界淡暖描线（DataV.GeoJSON，懒加载）
        fetch('/geo/china.json').then(function (r) { return r.json(); }).then(function (geo) {
          var layer = L.geoJSON(geo, {
            interactive: false,
            style: { color: '#4a4234', weight: 1, opacity: 0.9, fillColor: '#1d1a14', fillOpacity: 0.6 },
          }).addTo(map);
          map.fitBounds(layer.getBounds(), { padding: [10, 10] });
        }).catch(function () {});
        var bounds = [];
        pts.forEach(function (p) {
          var icon = L.divIcon({
            className: 'pl-pin',
            html: '<span class="pl-dot"></span>',
            iconSize: [22, 22], iconAnchor: [11, 11],
          });
          var m = L.marker([p.lat, p.lng], { icon: icon, title: p.name }).addTo(map);
          m.bindTooltip(p.name + ' · ' + p.count + ' 次相遇', { direction: 'top', offset: [0, -10] });
          m.bindPopup(
            '<b>' + p.name.replace(/&/g, '&amp;').replace(/</g, '&lt;') + '</b><br/>' + p.count + ' 次相遇' +
            (p.url ? '<br/><a href="' + p.url + '">查看地点 →</a>' : '')
          );
          bounds.push([p.lat, p.lng]);
        });
        if (bounds.length === 1) map.setView(bounds[0], 8);
        else map.fitBounds(L.latLngBounds(bounds).pad(0.4), { maxZoom: 9 });
        var zoom = document.createElement('div');
        zoom.className = 'pl-zoom';
        zoom.innerHTML = '<button type="button" aria-label="放大">＋</button><button type="button" aria-label="缩小">－</button>';
        el.appendChild(zoom);
        zoom.children[0].addEventListener('click', function () { map.zoomIn(); });
        zoom.children[1].addEventListener('click', function () { map.zoomOut(); });
      }
      if (document.readyState !== 'loading') init();
      else document.addEventListener('DOMContentLoaded', init);
      document.addEventListener('astro:page-load', init);
    })();
  </script>
</Base>

<style>
  .places-map-panel {
    position: relative; margin: 0 0 46px;
    border: 1px solid #332d24; border-radius: 8px; overflow: hidden;
    background: #14110c;
    box-shadow: 0 2px 24px rgba(20, 17, 12, 0.35);
  }
  .places-map { height: 460px; background: #14110c; }
  .places-map-legend {
    display: flex; align-items: center; gap: 12px;
    padding: 11px 16px; font-size: 12.5px; color: #b3a992; letter-spacing: 0.05em;
    border-top: 1px solid #2c271e; background: #171310;
  }
  .places-map-legend .n { color: #d96a45; font-weight: 700; }
  .places-map-legend .src { margin-left: auto; font-size: 11px; color: #6f675c; }
  /* 光点标记：陶土红 + 柔光晕（运行时节点 → :global） */
  .places-map :global(.pl-pin) { background: none; border: none; }
  .places-map :global(.pl-pin .pl-dot) {
    display: block; width: 12px; height: 12px; margin: 5px; border-radius: 50%;
    background: #d96a45; border: 2px solid #ffd9c4;
    box-shadow: 0 0 0 3px rgba(217, 106, 69, 0.22), 0 0 18px 4px rgba(217, 106, 69, 0.5);
    transition: transform 0.15s ease;
  }
  .places-map :global(.pl-pin:hover .pl-dot) { transform: scale(1.35); }
  /* 悬停提示（暗卡） */
  .places-map :global(.leaflet-tooltip) {
    background: #26221c; color: #eae5d8; border: 1px solid #3a342a;
    border-radius: 8px; font: 12px/1.4 var(--sans); box-shadow: none; padding: 5px 10px;
  }
  .places-map :global(.leaflet-tooltip-top:before) { border-top-color: #3a342a; }
  /* 弹窗（暗卡 + 衬线地名） */
  .places-map :global(.leaflet-popup-content-wrapper) {
    background: #1d1a14; color: #eae5d8; border: 1px solid #3a342a;
    border-radius: 10px; box-shadow: 0 14px 40px rgba(0, 0, 0, 0.5);
  }
  .places-map :global(.leaflet-popup-tip) { background: #1d1a14; border: 1px solid #3a342a; }
  .places-map :global(.leaflet-popup-content) { margin: 12px 16px; font: 13px/1.7 var(--sans); }
  .places-map :global(.leaflet-popup-content b) { font-family: var(--serif); font-size: 14.5px; color: #f0ead9; }
  .places-map :global(.leaflet-popup-content a) { color: #d96a45; }
  .places-map :global(.leaflet-container) { font-family: var(--sans); background: #14110c; }
  @media (max-width: 720px) {
    .places-map { height: 340px; }
  }
</style>
