---
export const prerender = true;
import Base from '../layouts/Base.astro';
import { getLocalityCards } from '../lib/queries';
import { withBase } from '../lib/privacy';

const cards = getLocalityCards();
// 地图模块数据：有坐标的地点（坐标全量公开，§地点）
const mapPoints = cards
  .filter((c) => c.latitude != null && c.longitude != null)
  .map((c) => ({
    lat: c.latitude,
    lng: c.longitude,
    name: c.name,
    count: c.count,
    url: c.place_id ? withBase(`/places/${c.place_id}/`) : null,
  }));
// 全球地理：顶层按国家分组，其下按一级行政区（SOP §104）
const byCountry = new Map<string, Map<string, typeof cards>>();
for (const c of cards) {
  const byAdmin1 = byCountry.get(c.country_name) ?? new Map<string, typeof cards>();
  const list = byAdmin1.get(c.admin1) ?? [];
  list.push(c);
  byAdmin1.set(c.admin1, list);
  byCountry.set(c.country_name, byAdmin1);
}
---

<Base title="地点" description="每一次相遇都有明确的位置。按国家与地点浏览观察记录。">
  <div class="container-wide">
    <div class="page-title">
      <h1>地点</h1>
      <p class="lede">
        本站的主角是地方：一片林缘、一段河谷、一面城市里的老墙。
      </p>
    </div>

    {mapPoints.length > 0 && (
      <div class="places-map-panel">
        <div id="places-map" class="places-map" />
        <script type="application/json" id="places-map-data" set:html={JSON.stringify(mapPoints)} />
        <div class="places-map-legend">分布 · 点击标记查看 <span class="n">{mapPoints.length} 处</span><span class="src">轮廓 Natural Earth</span></div>
      </div>
    )}

    <div class="place-groups">
      {[...byCountry.entries()].map(([country, byAdmin1]) => (
        <section class="place-group">
          <h2>{country}<span class="n">{[...byAdmin1.values()].flat().reduce((n, c) => n + c.count, 0)} 次相遇</span></h2>
          {[...byAdmin1.entries()].map(([admin1, list]) => (
          <div style="margin-bottom: 30px;">
            <div class="kicker on-paper" style="margin-bottom: 12px;">{admin1}</div>
            <div class="place-cards">
            {list.map((c) => (
              c.place_id ? (
                <a class="place-card" href={withBase(`/places/${c.place_id}/`)}>
                  <div class="frame">{c.cover && <img src={c.cover.medium} alt={c.name} loading="lazy" />}</div>
                  <div class="name">{c.name}</div>
                  <div class="meta">
                    {c.admin1}
                    {c.elevation != null && ` · 海拔约 ${c.elevation} m`}
                    {` · ${c.count} 次相遇`}
                  </div>
                  {c.habitats.length > 0 && <div class="habitats">{c.habitats.join(' / ')}</div>}
                </a>
              ) : (
                <div class="place-card">
                  <div class="frame">{c.cover && <img src={c.cover.medium} alt={c.name} loading="lazy" />}</div>
                  <div class="name">{c.name}</div>
                  <div class="meta">
                    {c.admin1}
                    {c.elevation != null && ` · 海拔约 ${c.elevation} m`}
                    {` · ${c.count} 次相遇`}
                  </div>
                  {c.habitats.length > 0 && <div class="habitats">{c.habitats.join(' / ')}</div>}
                </div>
              )
            ))}
            </div>
          </div>
          ))}
        </section>
      ))}
      <p class="place-legend">
        本站所有观察地点坐标均精确公开（可在地图中直接查看）。本页仅显示本站实际记录，不代表任何物种的完整分布；具体观察请到「观察」页按永久编号检索。
      </p>
    </div>
  </div>

  <link rel="stylesheet" href={withBase('/vendor/maplibre-gl.css')} />
  <script is:inline src={withBase('/vendor/maplibre-gl.js')}></script>
  <script is:inline src={withBase('/vendor/topojson-client.js')}></script>
  <link rel="stylesheet" href={withBase('/vendor/maplibre-gl.css')} />
  <script is:inline src={withBase('/vendor/maplibre-gl.js')}></script>
  <script is:inline src={withBase('/vendor/topojson-client.js')}></script>
  <script is:inline>
    (function () {
      function esc(s) { return String(s == null ? '' : s).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); }
      var booted = false;
      function boot() {
        var el = document.getElementById('places-map');
        var dataEl = document.getElementById('places-map-data');
        if (!el || !dataEl || el.dataset.inited === '1') return;
        if (typeof maplibregl === 'undefined' || typeof topojson === 'undefined') return;
        el.dataset.inited = '1';
        var pts = JSON.parse(dataEl.textContent || '[]');
        fetch('/geo/world.json').then(function (r) { return r.json(); }).then(function (topo) {
          var countries = topojson.feature(topo, topo.objects.countries);
          var places = {
            type: 'FeatureCollection',
            features: pts.map(function (p) {
              return { type: 'Feature', geometry: { type: 'Point', coordinates: [p.lng, p.lat] }, properties: { name: p.name, count: p.count, url: p.url || '' } };
            }),
          };
          var map = new maplibregl.Map({
            container: el,
            style: {
              version: 8,
              sources: {
                countries: { type: 'geojson', data: countries },
                places: { type: 'geojson', data: places },
              },
              layers: [
                { id: 'bg', type: 'background', paint: { 'background-color': '#efe9da' } },
                { id: 'land-fill', type: 'fill', source: 'countries', paint: { 'fill-color': '#f6f1e4', 'fill-opacity': 1 } },
                { id: 'land-line', type: 'line', source: 'countries', paint: { 'line-color': '#b9ac8f', 'line-width': 0.7, 'line-opacity': 0.9 } },
                { id: 'place-halo', type: 'circle', source: 'places', paint: { 'circle-radius': 15, 'circle-color': '#b5502c', 'circle-opacity': 0.16 } },
                { id: 'place-core', type: 'circle', source: 'places', paint: { 'circle-radius': 5.5, 'circle-color': '#b5502c', 'circle-stroke-width': 2, 'circle-stroke-color': '#ffffff' } },
              ],
            },
            attributionControl: false,
            scrollZoom: false,
            dragRotate: false,
            pitchWithRotate: false,
          });
          window.__placesMap = map;
          window.__mapErrs = [];
          map.on('error', function (e) { window.__mapErrs.push(String((e && e.error && e.error.message) || e)); });
          map.touchZoomRotate.disableRotation();
          map.addControl(new maplibregl.NavigationControl({ showCompass: false }), 'top-right');
          // 世界视野 + 确保观察点可见
          var b = new maplibregl.LngLatBounds();
          function extendCoords(coords) {
            if (typeof coords[0] === 'number') b.extend(coords);
            else coords.forEach(extendCoords);
          }
          countries.features.forEach(function (f) { extendCoords(f.geometry.coordinates); });
          pts.forEach(function (p) { b.extend([p.lng, p.lat]); });
          map.fitBounds(b, { padding: 26, maxZoom: 7, duration: 0 });
          // 观察点：点击弹详情卡
          map.on('click', 'place-core', function (e) {
            var p = e.features[0].properties;
            new maplibregl.Popup({ offset: 14, closeButton: false })
              .setLngLat(e.lngLat)
              .setHTML('<b>' + esc(p.name) + '</b><br/>' + p.count + ' 次相遇' + (p.url ? '<br/><a href="' + p.url + '">查看地点 →</a>' : ''))
              .addTo(map);
          });
          map.on('mouseenter', 'place-core', function () { map.getCanvas().style.cursor = 'pointer'; });
          map.on('mouseleave', 'place-core', function () { map.getCanvas().style.cursor = ''; });
          // 容器尺寸在创建后才稳定：加载完成与窗口变化时重排画布
          map.on('load', function () { setTimeout(function () { map.resize(); }, 60); });
          window.addEventListener('resize', function () { map.resize(); });
        }).catch(function () {
          el.style.display = 'none';
        });
      }
      if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot);
      else boot();
      document.addEventListener('astro:page-load', boot);
    })();
  </script>
</Base>

<style>
  .places-map-panel {
    position: relative; margin: 0 0 46px;
    border: 1px solid var(--line); border-radius: 8px; overflow: hidden;
    background: var(--paper);
    box-shadow: 0 1px 0 rgba(38, 34, 28, 0.05);
  }
  .places-map { height: 460px; background: #f2eee2; }
  .places-map-legend {
    display: flex; align-items: center; gap: 12px;
    padding: 11px 16px; font-size: 12.5px; color: var(--muted); letter-spacing: 0.05em;
    border-top: 1px solid var(--line-soft); background: var(--paper);
  }
  .places-map-legend .n { color: var(--terra); font-weight: 700; }
  .places-map-legend .src { margin-left: auto; font-size: 11px; color: var(--faint); }
  /* MapLibre 弹卡（白卡 + 衬线地名）与控件 */
  .places-map :global(.maplibregl-popup-content) {
    background: #fff; color: var(--ink); border: 1px solid var(--line);
    border-radius: 10px; box-shadow: 0 10px 28px rgba(38, 34, 28, 0.14);
    padding: 12px 16px; font: 13px/1.7 var(--sans);
  }
  .places-map :global(.maplibregl-popup-content b) { font-family: var(--serif); font-size: 14.5px; }
  .places-map :global(.maplibregl-popup-content a) { color: var(--terra); }
  .places-map :global(.maplibregl-popup-tip) { border-top-color: #fff; border-bottom-color: #fff; }
  .places-map :global(.maplibregl-ctrl-group) {
    border-radius: 8px; overflow: hidden;
    box-shadow: 0 2px 10px rgba(38, 34, 28, 0.12);
  }
  .places-map :global(.maplibregl-ctrl-group button) { width: 30px; height: 30px; }
  .places-map :global(.maplibregl-canvas) { outline: none; }
  @media (max-width: 720px) {
    .places-map { height: 340px; }
  }
</style>
