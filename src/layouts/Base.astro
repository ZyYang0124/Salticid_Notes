---
import '../styles/global.css';
import SearchBox from '../components/SearchBox.astro';
import { ClientRouter } from 'astro:transitions';
import { siteConfig } from '../lib/store';
import { withBase } from '../lib/privacy';

interface Props {
  title?: string;
  description?: string;
  /** 首页 Hero LCP 预加载（仅首页传入） */
  preload?: { href: string; imagesrcset?: string; imagesizes?: string };
  /** Open Graph 预览图（相对路径，如 /media/derivatives/...） */
  ogImage?: string;
}

const { title, description = siteConfig.subtitle, preload, ogImage } = Astro.props;
const SITE_URL = 'https://salticidnotes.cn';
const ogImageAbs = ogImage ? SITE_URL + withBase(ogImage) : SITE_URL + withBase('/media/derivatives/SFN-M-000008-1280.jpg');
const pageTitle = title ? `${title} · ${siteConfig.site_name}` : siteConfig.site_name;

const nav = [
  { href: '/observations/', label: '观察' },
  { href: '/species/', label: '物种' },
  { href: '/media/', label: '影像' },
  { href: '/posts/', label: '札记' },
  { href: '/places/', label: '地点' },
  { href: '/contributors/', label: '伙伴' },
  { href: '/about/', label: '关于' },
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('theme');
          if (!t) t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          document.documentElement.dataset.theme = t;
        } catch (e) {}
      })();
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={withBase('/favicon-32.png')} type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href={withBase('/favicon-180.png')} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageAbs} />
    <meta property="og:url" content={SITE_URL + withBase(Astro.url.pathname)} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href={SITE_URL + withBase(Astro.url.pathname)} />
    <meta name="generator" content={Astro.generator} />
    {preload && (
      <link
        rel="preload"
        as="image"
        href={preload.href}
        imagesrcset={preload.imagesrcset}
        imagesizes={preload.imagesizes}
        fetchpriority="high"
      />
    )}
    <ClientRouter />
  </head>
  <body>
    <header class="site-header" transition:persist>
      <div class="inner">
        <a class="brand" href={withBase('/')}>
          <img class="brand-mark" src={withBase('/logo-mark.png')} alt="" width="30" height="31" />
          <span class="zh">{siteConfig.site_name}</span>
        </a>
        <nav class="site-nav" aria-label="主导航">
          {nav.map((n) => (
            <a
              href={withBase(n.href)}
              aria-current={Astro.url.pathname.replace(/\/$/, '') === n.href.replace(/\/$/, '') ? 'page' : undefined}
            >
              {n.label}
            </a>
          ))}
        </nav>
        <SearchBox />
        <button class="theme-toggle" type="button" data-theme-toggle aria-label="切换白天/夜间模式"></button>
        <button class="menu-btn" type="button" aria-label="打开菜单" aria-expanded="false" data-menu-open>
          <svg width="22" height="22" viewBox="0 0 22 22" fill="none" aria-hidden="true">
            <path d="M3 6h16M3 11h16M3 16h16" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
          </svg>
        </button>
      </div>
    </header>

    <!-- 移动端全屏菜单（§23） -->
    <nav class="mobile-nav" id="mobile-nav" aria-label="移动导航" hidden>
      <button class="close" type="button" aria-label="关闭菜单" data-menu-close>×</button>
      {nav.map((n) => <a href={withBase(n.href)} data-menu-link>{n.label}</a>)}
    </nav>

    <main>
      <slot />
    </main>

    <footer class="site-footer" data-railing transition:persist>
      <div class="inner">
        <div class="mark"><img src={withBase('/logo-mark.png')} alt="" width="38" height="40" /></div>
        <div class="fn">{siteConfig.site_name}</div>
        <p class="motto">每一条记录，都始于一次相遇。</p>
        <p class="legal">
          © {new Date().getFullYear()} {siteConfig.copyright_holder}
          <span class="sep">·</span>
          <a href="https://github.com/ZyYang0124/Salticid_Notes" rel="noopener">GitHub</a>
          <span class="sep">·</span>
          <a href={withBase('/about/#colophon')}>Colophon</a>
        </p>
      </div>
    </footer>

    <!-- Studio 入口：低存在感，仅 corner 一枚（§33） -->
    <a class="studio-entry" href="https://studio.salticidnotes.cn/studio" title="Studio" aria-label="Studio">✎</a>
    <style>
      .studio-entry {
        position: fixed; right: 14px; bottom: 14px; z-index: 60;
        width: 34px; height: 34px; border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        color: var(--faint, #948b7d); background: transparent;
        text-decoration: none; font-size: 15px;
        opacity: .55; transition: opacity 180ms ease;
      }
      .studio-entry:hover { opacity: 1; }
      @media print { .studio-entry { display: none; } }
    </style>

  <script>
    // 移动端菜单：开/关 + Esc + 点击链接后关闭
    function initMenu() {
      const btn = document.querySelector('[data-menu-open]');
      const nav = document.getElementById('mobile-nav');
      if (!btn || !nav) return;
      const close = nav.querySelector('[data-menu-close]');
      const setOpen = (open) => {
        nav.hidden = !open;
        nav.classList.toggle('open', open);
        btn.setAttribute('aria-expanded', String(open));
        document.body.style.overflow = open ? 'hidden' : '';
      };
      btn.addEventListener('click', () => setOpen(true));
      close?.addEventListener('click', () => setOpen(false));
      nav.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).closest('[data-menu-link]')) setOpen(false);
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') setOpen(false);
      });
    }
    document.addEventListener('astro:page-load', initMenu);

    // 主题切换：白天/夜间，localStorage 记忆，ClientRouter 导航后保持
    function applyTheme(t) { document.documentElement.dataset.theme = t; }
    function initThemeToggle() {
      const btn = document.querySelector('[data-theme-toggle]');
      if (!btn || btn.dataset.init === '1') return;
      btn.dataset.init = '1';
      const render = () => {
        const dark = document.documentElement.dataset.theme === 'dark';
        btn.textContent = dark ? '☀' : '☽';
        btn.setAttribute('aria-label', dark ? '切换到白天模式' : '切换到夜间模式');
      };
      btn.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        applyTheme(next);
        try { localStorage.setItem('theme', next); } catch (e) {}
        render();
      });
      document.addEventListener('astro:after-swap', () => {
        applyTheme(document.documentElement.dataset.theme || 'light');
        render();
      });
      render();
    }
    initThemeToggle();
    document.addEventListener('astro:after-swap', initThemeToggle);

    // Scroll Reveal：进入视口一次上浮，不做重复动画；reduced-motion 时直接可见。
    function initReveal() {
      const els = document.querySelectorAll('.reveal:not(.is-visible)');
      if (!els.length) return;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) {
        els.forEach((el) => el.classList.add('is-visible'));
        return;
      }
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((en) => {
            if (en.isIntersecting) {
              en.target.classList.add('is-visible');
              io.unobserve(en.target);
            }
          });
        },
        { threshold: 0.1, rootMargin: '0px 0px -6% 0px' },
      );
      els.forEach((el) => io.observe(el));
    }
    document.addEventListener('astro:page-load', initReveal);
  </script>
  </body>
</html>
