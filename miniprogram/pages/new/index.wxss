.sec-hint {
  padding: 22rpx 30rpx 0;
  font-size: 12px;
  color: #a2967e;
}

.thumbs {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.thumb {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background: #eee7d8;
}

.thumb image {
  width: 100%;
  height: 100%;
}

.thumb.add {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40px;
  color: #b5502e;
  border: 2rpx dashed #c9bda1;
  background: #fffdf8;
}

.state {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  font-size: 11px;
  text-align: center;
  padding: 4rpx 0;
  color: #fff;
}

.state.uploading {
  background: rgba(38, 34, 28, 0.72);
}

.state.done {
  background: rgba(76, 107, 60, 0.85);
}

.state.err {
  background: rgba(181, 80, 46, 0.9);
}

.del {
  position: absolute;
  top: 4rpx;
  right: 6rpx;
  width: 44rpx;
  height: 44rpx;
  line-height: 40rpx;
  text-align: center;
  border-radius: 50%;
  background: rgba(38, 34, 28, 0.6);
  color: #fff;
  font-size: 16px;
}

.exif {
  margin-top: 16rpx;
  font-size: 12px;
  color: #4c6b3c;
  background: #ecf3e6;
  border-radius: 10rpx;
  padding: 12rpx 18rpx;
}

.picker-val {
  color: #2b2620;
}

.suggest {
  border: 1rpx solid #ddd3bd;
  border-radius: 12rpx;
  margin-top: 10rpx;
  overflow: hidden;
}

.sg {
  display: flex;
  justify-content: space-between;
  padding: 14rpx 20rpx;
  border-bottom: 1rpx solid #eee7d8;
  background: #fff;
}

.sg:last-child {
  border-bottom: none;
}

.sg-name {
  font-style: italic;
  font-family: Georgia, serif;
}

.sg-status {
  font-size: 11px;
  color: #8a5a22;
}

.actions {
  padding: 10rpx 24rpx 90rpx;
}
